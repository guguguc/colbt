/* Discord-inspired dark theme */
* {
    font-family: "Microsoft YaHei", "PingFang SC", "Noto Sans CJK SC", sans-serif;
    outline: none;
}
QWidget { color: #dbdee1; }

QMainWindow, QDialog {
    background: #313338;
    color: #dbdee1;
}

QToolTip {
    background: #111214;
    color: #f2f3f5;
    border: 1px solid #1e1f22;
    padding: 5px 8px;
}

QScrollBar:vertical {
    background: transparent;
    width: 8px;
    margin: 2px 0;
}
QScrollBar::handle:vertical {
    background: #1e1f22;
    border-radius: 4px;
    min-height: 32px;
}
QScrollBar::handle:vertical:hover { background: #111214; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical { background: transparent; }
QScrollBar:horizontal { background: transparent; height: 8px; }
QScrollBar::handle:horizontal { background: #1e1f22; border-radius: 4px; min-width: 30px; }
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { width: 0; }

/* Login */
#loginWindow {
    background: #313338;
}
#loginLogo {
    color: #f2f3f5;
    font-size: 40px;
    font-weight: bold;
}
#loginSubtitle {
    color: #b5bac1;
    font-size: 13px;
}
#loginWindow QLineEdit {
    background: #1e1f22;
    color: #f2f3f5;
    border: 1px solid #1e1f22;
    border-radius: 4px;
    padding: 10px 12px;
    font-size: 14px;
}
#loginWindow QLineEdit:focus {
    border-color: #5865f2;
    background: #1e1f22;
}
#primaryBtn {
    background: #5865f2;
    color: #ffffff;
    border: none;
    border-radius: 4px;
    padding: 10px 0;
    font-size: 15px;
    font-weight: bold;
}
#primaryBtn:hover { background: #4752c4; }
#primaryBtn:pressed { background: #3c45a5; }
#primaryBtn:disabled { background: #454fbf; color: #b5bac1; }
#linkBtn {
    background: transparent;
    border: none;
    color: #00a8fc;
    font-size: 13px;
}
#linkBtn:hover { color: #5865f2; }
#smallEdit {
    background: #1e1f22;
    color: #dbdee1;
    border: 1px solid #1e1f22;
    border-radius: 4px;
    padding: 6px 8px;
}
#smallEdit:focus { border-color: #5865f2; }
#statusLabel { color: #f23f42; font-size: 13px; }

/* Main three-column shell */
#mainCentral { background: #313338; }
#rail {
    background: #1e1f22;
    border-right: 1px solid #111214;
}
#myAvatar {
    border: none;
    padding: 0;
}
#navBtn {
    background: transparent;
    border: none;
    border-radius: 8px;
    color: #949ba4;
    padding: 10px 4px;
    font-size: 11px;
    width: 62px;
}
#navBtn:hover { background: #35373c; color: #f2f3f5; }
#navBtn:checked {
    background: #404249;
    color: #f2f3f5;
    border-left: 3px solid #5865f2;
}
#listWrap {
    background: #2b2d31;
    border-right: 1px solid #1e1f22;
}
#listTitle {
    background: #2b2d31;
    color: #dbdee1;
    font-size: 15px;
    font-weight: 600;
    padding-left: 14px;
    border-bottom: 1px solid #1e1f22;
}
#contactToolbar { background: #2b2d31; }
#toolBtn {
    background: #383a40;
    color: #dbdee1;
    border: 1px solid #45474f;
    border-radius: 4px;
    padding: 5px 10px;
    font-size: 12px;
}
#toolBtn:hover { background: #45474f; color: #ffffff; }
#toolBtn:pressed { background: #5865f2; }

QListWidget {
    background: #2b2d31;
    color: #dbdee1;
    border: none;
}
QListWidget::item { border: none; background: transparent; }
QListWidget::item:selected { background: #404249; }

QTreeWidget {
    background: #2b2d31;
    color: #dbdee1;
    border: none;
    padding: 8px 4px;
}
QTreeWidget::item {
    height: 40px;
    border-radius: 4px;
    padding-left: 4px;
}
QTreeWidget::item:hover { background: #35373c; }
QTreeWidget::item:selected { background: #404249; color: #ffffff; }
QTreeWidget::branch { background: #2b2d31; }

QMenu {
    background: #111214;
    color: #dbdee1;
    border: 1px solid #1e1f22;
    padding: 6px 0;
}
QMenu::item { padding: 7px 30px 7px 16px; }
QMenu::item:selected { background: #5865f2; color: #ffffff; }

/* Chat */
#chatPanel { background: #313338; }
#chatHeader {
    background: #313338;
    border-bottom: 1px solid #1e1f22;
}
#chatTitle {
    color: #f2f3f5;
    font-size: 16px;
    font-weight: bold;
}
#chatStatus { color: #949ba4; font-size: 12px; margin-right: 8px; }
#infoBtn, #emojiBtn {
    background: transparent;
    border: none;
    color: #b5bac1;
    border-radius: 4px;
    font-size: 18px;
}
#infoBtn:hover, #emojiBtn:hover { background: #383a40; color: #ffffff; }

#inputBox {
    background: #313338;
    border-top: 1px solid #1e1f22;
}
QTextEdit {
    background: #383a40;
    color: #dbdee1;
    border: none;
    border-radius: 6px;
    font-size: 14px;
    padding: 8px 10px;
    selection-background-color: #5865f2;
}
QTextEdit:focus { background: #404249; }
QTextEdit:disabled { background: #2b2d31; color: #72767d; }
#sendBtn {
    background: #5865f2;
    color: #ffffff;
    border: none;
    border-radius: 4px;
    font-size: 13px;
    font-weight: bold;
}
#sendBtn:hover { background: #4752c4; }
#sendBtn:pressed { background: #3c45a5; }
#sendBtn:disabled { background: #45474f; color: #72767d; }
#timeLabel { color: #72767d; font-size: 11px; padding: 6px; }

QMessageBox, QInputDialog {
    background: #313338;
    color: #dbdee1;
}
QMessageBox QLabel, QInputDialog QLabel { color: #dbdee1; }
